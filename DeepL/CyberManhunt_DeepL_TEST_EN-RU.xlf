<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.1" srcLang="en" trgLang="ru"><file id="cyber-manhunt-trial" original="Cyber Manhunt English localization"><unit id="u0001" name="^start_game" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Game Start</source></segment></unit><unit id="u0002" name="^target_portrait" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Target Portrait</source></segment></unit><unit id="u0003" name="^tab_inBox" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Inbox</source></segment></unit><unit id="u0004" name="^tab_write" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Compose</source></segment></unit><unit id="u0005" name="^tab_sended" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Sent</source></segment></unit><unit id="u0006" name="^tab_changeAcc" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Switch User</source></segment></unit><unit id="u0007" name="^tab_social" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Database</source></segment></unit><unit id="u0008" name="^tab_camouflage" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Phishing</source></segment></unit><unit id="u0009" name="^tab_picAls" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Picture Analysis</source></segment></unit><unit id="u0010" name="^tab_crack" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Crack</source></segment></unit><unit id="u0011" name="^copy" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Copy</source></segment></unit><unit id="u0012" name="^open" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Open</source></segment></unit><unit id="u0013" name="^paste" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Paste</source></segment></unit><unit id="u0014" name="^password" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Password</source></segment></unit><unit id="u0015" name="^crack" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">CRACK</source></segment></unit><unit id="u0016" name="^txt_pwtitle" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Choose target information to generate the password:</source></segment></unit><unit id="u0017" name="^password_tip01" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Enter information</source></segment></unit><unit id="u0018" name="^password_tip02" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">The passwords set by people are usually related to their personal information. The cracking tool will arrange and combine each piece of information to generate a password.  <ph id="c1" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />TIPS: The correct password can only be generated if the accuracy reaches 100%</source></segment></unit><unit id="u0019" name="^password_failed" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Cracking failed</source></segment></unit><unit id="u0020" name="^password_mail" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Password reset email has been sent.</source></segment></unit><unit id="u0021" name="^psw_name" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Real name:</source></segment></unit><unit id="u0022" name="^psw_socialnum" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">ID number:</source></segment></unit><unit id="u0023" name="^psw_nickname" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Nickname:</source></segment></unit><unit id="u0024" name="^psw_birth" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">DOB:</source></segment></unit><unit id="u0025" name="^psw_phone" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Tel:</source></segment></unit><unit id="u0026" name="^psw_home" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">House Num:</source></segment></unit><unit id="u0027" name="^sql01" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Name:</source></segment></unit><unit id="u0028" name="^sql02" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Additional info:</source></segment></unit><unit id="u0029" name="^course01" canResegment="no"><originalData><data id="d1" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d2" xml:space="preserve">&lt;/color&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Search this keyword in<pc id="c1" dataRefStart="d1" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d2" dispEnd="&lt;/color&gt;"> the browser </pc>and see what you can get.</source></segment></unit><unit id="u0030" name="^course02" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Click on the clue and click copy.</source></segment></unit><unit id="u0031" name="^course03" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Open the browser.</source></segment></unit><unit id="u0032" name="^course04" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Paste the keyword into the search box.  (Or manually input: <mrk id="c1" translate="no" type="term">TC191</mrk>)</source></segment></unit><unit id="u0033" name="^course0401" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Click the search button and see what can be found.</source></segment></unit><unit id="u0034" name="^course05" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">It is also important to review the search results. Obviously, not all results are relevant to our target.</source></segment></unit><unit id="u0035" name="^course06" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Click on the <mrk id="c1" translate="no" type="term">Toothbook</mrk> link to enter the social network of the target person.</source></segment></unit><unit id="u0036" name="^course07" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Please read carefully and find every piece of useful information.</source></segment></unit><unit id="u0037" name="^course08" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">This seems to be the real name of the target person, which can be collected into the shared folder.</source></segment></unit><unit id="u0038" name="^course0801" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Continue to investigate this <mrk id="c1" translate="no" type="term">Toothbook</mrk> account. There may be other useful information.</source></segment></unit><unit id="u0039" name="^course09" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Each photo contains a lot of information.</source></segment></unit><unit id="u0040" name="^course10" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">This photo seems to be related to someone's birthday. You can upload it to the shared folder first and then identify the clues found on the photo.</source></segment></unit><unit id="u0041" name="^course11" canResegment="no"><originalData><data id="d1" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d2" xml:space="preserve">&lt;/color&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Once you have<pc id="c1" dataRefStart="d1" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d2" dispEnd="&lt;/color&gt;"> the real name </pc>and additional information of the target person, you can use <mrk id="c2" translate="no" type="term">Titan</mrk>'s personal information database to obtain more private details.</source></segment></unit><unit id="u0042" name="^course12" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Now let's launch the database and conduct a search.</source></segment></unit><unit id="u0043" name="^course1201" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">We have found information on the target person. Collect it quickly.</source></segment></unit><unit id="u0044" name="^course13" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Congratulations! You obtained his email address. Each person's mailbox is always important. Many useful clues may be hidden in it.</source></segment></unit><unit id="u0045" name="^course14" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">We still need a password to log in to the mailbox. We should have enough personal details.</source></segment></unit><unit id="u0046" name="^course15" canResegment="no"><originalData><data id="d1" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d2" xml:space="preserve">&lt;/color&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Try<pc id="c1" dataRefStart="d1" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d2" dispEnd="&lt;/color&gt;"> the hacking tool </pc>to obtain the password based on his details.</source></segment></unit><unit id="u0047" name="^course1501" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Collect the password.</source></segment></unit><unit id="u0048" name="^course16" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">We have obtained the email address and password. Log in to the mailbox of the target to have a look.</source></segment></unit><unit id="u0049" name="^course17" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">If you closed the mailbox, you can log in again by clicking the mailbox icon below.</source></segment></unit><unit id="u0050" name="^course1701" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">This looks like the business mailbox of the target. A closer investigation may reveal his colleagues and other important clues.</source></segment></unit><unit id="u0051" name="^course1702" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">If you leverage his social network, you will have the opportunity to obtain the access key by phishing.</source></segment></unit><unit id="u0052" name="^course18" canResegment="no"><originalData><data id="d1" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d2" xml:space="preserve">&lt;/color&gt;</data><data id="d3" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d4" xml:space="preserve">&lt;/color&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">When we have<pc id="c1" dataRefStart="d1" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d2" dispEnd="&lt;/color&gt;"> the <mrk id="c2" translate="no" type="term">Hitalk</mrk> ID </pc>of the target person and the information of<pc id="c3" dataRefStart="d3" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d4" dispEnd="&lt;/color&gt;"> the people around him</pc>. We can pretend to be his friend and try phishing.</source></segment></unit><unit id="u0053" name="^course19" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">It's because people tend to trust familiar faces more than strangers.</source></segment></unit><unit id="u0054" name="^course20" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Maybe we can pose as the head of the network department, a seemingly senior position.  It may help you get the access key.</source></segment></unit><unit id="u0055" name="^course21" canResegment="no"><originalData><data id="d1" xml:space="preserve">&lt;color=#CC1414&gt;</data><data id="d2" xml:space="preserve">&lt;/color&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Before you start phishing, you'd better<pc id="c1" dataRefStart="d1" dispStart="&lt;color=#CC1414&gt;" type="fmt" canCopy="no" canDelete="no" canReorder="no" dataRefEnd="d2" dispEnd="&lt;/color&gt;"> browse the target's mailbox again</pc> and remember the key information. Any inaccurate comments will alert the target and cause the mission to fail.</source></segment></unit><unit id="u0056" name="^course22" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Once you get the information we need, you can submit it.  This is will complete your mission.</source></segment></unit><unit id="u0057" name="^course23" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">For some targets, you need to collect enough information before using inference to process them.</source></segment></unit><unit id="u0058" name="^course24" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">If inference is being used, please complete it as soon as possible. It sometimes provides new clues for the investigation.</source></segment></unit><unit id="u0059" name="^course25" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Inference may be used after some targets are reached. Click here to start.</source></segment></unit><unit id="u0060" name="^dialogue0001" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hey <mrk id="c1" translate="no" type="term">Thomas</mrk>, this is <mrk id="c2" translate="no" type="term">Tom Blanco</mrk></source></segment></unit><unit id="u0061" name="^dialogue0002" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hello Mr. <mrk id="c1" translate="no" type="term">Blanco</mrk>, is something wrong so late in the evening?</source></segment></unit><unit id="u0062" name="^dialogue0003_0101" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">It's about this business trip. Because I was in a hurry, I left my notebook in the company. It has a lot of important notes.</source></segment></unit><unit id="u0063" name="^dialogue0003_0102" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I need to log in to the system right now, but I can't remember the administrator key. Can you help me?</source></segment></unit><unit id="u0064" name="^dialogue0003_02" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I don't remember the administrator key. Can you help me?</source></segment></unit><unit id="u0065" name="^dialogue0003_03" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">It's about the evaluation. I'm going to give you the highest score.</source></segment></unit><unit id="u0066" name="^dialogue0004_01" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Ah, that's unfortunate. Which city are you in now?</source></segment></unit><unit id="u0067" name="^dialogue0004_0201" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Are you the real Mr. <mrk id="c1" translate="no" type="term">Knight</mrk>?  You are not one who will easily forget the key!</source></segment></unit><unit id="u0068" name="^dialogue0004_0202" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">But if you can tell me the color of the flowers on your desk, I will believe you!</source></segment></unit><unit id="u0069" name="^dialogue0004_03" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Really! It is a great honor to receive your compliment!  I will do my best!</source></segment></unit><unit id="u0070" name="^dialogue0005_0101" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I just arrived in <mrk id="c1" translate="no" type="term">Demanra</mrk>.</source></segment></unit><unit id="u0071" name="^dialogue0005_0102" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I just arrived in <mrk id="c1" translate="no" type="term">Gauti</mrk>.</source></segment></unit><unit id="u0072" name="^dialogue0005_0103" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I just arrived in <mrk id="c1" translate="no" type="term">Pedro</mrk>.</source></segment></unit><unit id="u0073" name="^dialogue0005_0201" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hmm, it’s red…</source></segment></unit><unit id="u0074" name="^dialogue0005_0202" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hmm, it’s blue…</source></segment></unit><unit id="u0075" name="^dialogue0005_0203" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hmm, it’s yellow…</source></segment></unit><unit id="u0076" name="^dialogue0005_03" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">You deserve it, but now I have a problem and need your help.</source></segment></unit><unit id="u0077" name="^dialogue0006_0101" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">When will you come back?</source></segment></unit><unit id="u0078" name="^dialogue0006_010201" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hey listen, kid. I'm pretty sure you are not <mrk id="c1" translate="no" type="term">William</mrk>. That's not where he went!</source></segment></unit><unit id="u0079" name="^dialogue0006_010202" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Before I get pissed off, you'd better disappear. Impersonating someone else is despicable!</source></segment></unit><unit id="u0080" name="^link_event_01_title" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Top Stories in Finance: After the recent suicide of <mrk id="c1" translate="no" type="term">Kapil Modi</mrk>,<ph id="c2" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" /> a competitor’s stock price skyrockets.</source></segment></unit><unit id="u0081" name="^link_event_01_desc" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">After the suicide of <mrk id="c1" translate="no" type="term">Kapil Modi</mrk>, founder of <mrk id="c2" translate="no" type="term">Defoss</mrk>, reports circulated of poor management within the company. Shortly after the tragic event, <mrk id="c3" translate="no" type="term">Devos</mrk> shut its doors. A competitor capitalized on the opportunity for market share, launching a rival drone delivery service. The endeavour won over investors by demonstrating the convenience and advantages of drone technology.</source></segment></unit><unit id="u0082" name="^link_event_01_content" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">After the suicide of <mrk id="c1" translate="no" type="term">Kapil Modi</mrk>, founder of <mrk id="c2" translate="no" type="term">Defoss</mrk>, reports circulated of poor management within the company. Shortly after the tragic event, <mrk id="c3" translate="no" type="term">Devos</mrk> shut its doors. A competitor capitalized on the opportunity for market share, launching a rival drone delivery service. The endeavour won over investors by demonstrating the convenience and advantages of drone technology. <ph id="c4" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />The WANT shopping website has completed testing on the drone delivery system. Shoppers are asked to install a drone delivery terminal at home. Going forward, all goods ordered online will be delivered by drone from a central distribution centre. Delivery time is expected to be in the range of several minutes. When approaching the delivery point, drones will use sound and light cues to signal arrival. The drone will then automatically access the at-home delivery terminal and return to the distribution centre. No actions are required on the part of the shopper.</source></segment></unit><unit id="u0083" name="^link_event_01_content2" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data><data id="d2" xml:space="preserve">\n</data><data id="d3" xml:space="preserve">&lt;Keyword&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve"><ph id="c1" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />This technology is likely to solve the delivery dilemma. Plenty of residents have pre-ordered the terminal installation service, it’s likely to be a standard for every family in the city in the near future. <ph id="c2" dataRef="d2" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />(To find out more, check out indie puzzle game <ph id="c3" dataRef="d3" disp="&lt;Keyword&gt;" equiv="" canCopy="no" canDelete="no" canReorder="no" /> on <mrk id="c4" translate="no" type="term">Steam</mrk>.)</source></segment></unit><unit id="u0084" name="^link_event_02_title" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Wikipedia: CV of <mrk id="c1" translate="no" type="term">Guo Chen</mrk>, Top Private Investigator</source></segment></unit><unit id="u0085" name="^link_event_02_desc" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Top Private investigator, <mrk id="c1" translate="no" type="term">Guo Chen</mrk>, specializes in logical deduction, hacker technology and social engineering.  Chen now provides investigation services to individual and commercial clients. Open for consultation.</source></segment></unit><unit id="u0086" name="^link_event_02_content" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data><data id="d2" xml:space="preserve">\n</data><data id="d3" xml:space="preserve">\n</data><data id="d4" xml:space="preserve">\n</data><data id="d5" xml:space="preserve">&lt;Keyword&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Private investigator. Individual or corporate cases only. Specialization in hacker technology and social engineering.  Will take care of business without leaving the house. <ph id="c1" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />Extreme social anxiety. Committed homebody. Prefers solitude. Offers investigation services, including personal cases, corporate espionage, and online information collection. Fees are high, but information is excellent quality and techniques are efficient.  <ph id="c2" dataRef="d2" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />For all consultations, contact me at <mrk id="c3" translate="no" type="term">guochen@cityfromnaught.com</mrk> or through the Holmes App. No phone calls, no office address, my camera will always be off during video chats. If this makes you uncomfortable, don’t contact me. To find out more, check out this indie puzzle game on <mrk id="c4" translate="no" type="term">Steam</mrk>.<ph id="c5" dataRef="d3" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" /><ph id="c6" dataRef="d4" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />(To find out more, check out indie puzzle game <ph id="c7" dataRef="d5" disp="&lt;Keyword&gt;" equiv="" canCopy="no" canDelete="no" canReorder="no" /> on <mrk id="c8" translate="no" type="term">Steam</mrk>.)</source></segment></unit><unit id="u0087" name="^link_event_03_title" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Missing Person Notice</source></segment></unit><unit id="u0088" name="^link_event_03_desc" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">My daughter <mrk id="c1" translate="no" type="term">Sala</mrk>, 18 years old, is missing. If anybody has information on her whereabouts, please contact me. You’ll have my eternal gratitude and a cash reward.Father: <mrk id="c2" translate="no" type="term">Guo Chen</mrk>.</source></segment></unit><unit id="u0089" name="^link_event_03_content" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data><data id="d2" xml:space="preserve">&lt;Keyword&gt;</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">My daughter <mrk id="c1" translate="no" type="term">Sala</mrk>, 18 years old, has been missing for three days. She’s a student at St. Carlei Secondary School. She was last seen alone in the <mrk id="c2" translate="no" type="term">Orbiseed</mrk> parking lot in Toronto. <ph id="c3" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" />(To find out more, check out indie puzzle game <ph id="c4" dataRef="d2" disp="&lt;Keyword&gt;" equiv="" canCopy="no" canDelete="no" canReorder="no" /> on <mrk id="c5" translate="no" type="term">Steam</mrk>.)</source></segment></unit><unit id="u0090" name="^link_event_04_title" canResegment="no"><originalData><data id="d1" xml:space="preserve">\n</data></originalData><segment id="s1" state="initial"><source xml:space="preserve">Data breach of superstar’s private information leads to police<ph id="c1" dataRef="d1" disp="\n" equiv=" " canCopy="no" canDelete="no" canReorder="no" /> investigation</source></segment></unit><unit id="u0091" name="^link_event_04_desc" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">In modern society, it is increasingly common for citizens to shun those outside of their social circles. At the same time, it seems that some people are willing to use illegal means to surveille those around them…</source></segment></unit><unit id="u0092" name="^emailtitle_event0001" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Reply to <mrk id="c1" translate="no" type="term">William Knight</mrk></source></segment></unit><unit id="u0093" name="^emailtitle_event0002" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Reply to <mrk id="c1" translate="no" type="term">fomin920</mrk></source></segment></unit><unit id="u0094" name="^emailtitle_event0003" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">I received your evaluation form.</source></segment></unit><unit id="u0095" name="^emailtitle_event0004" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Staff Evaluation</source></segment></unit><unit id="u0096" name="^emailtitle_event0005" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Hello, <mrk id="c1" translate="no" type="term">Thomas Conway</mrk>?</source></segment></unit><unit id="u0097" name="^txt_social01" canResegment="no"><originalData><data id="d1" xml:space="preserve">{0:S}</data><data id="d2" xml:space="preserve">{1:S}</data></originalData><segment id="s1" state="initial"><source xml:space="preserve"><ph id="c1" dataRef="d1" disp="{0:S}" equiv="" canCopy="no" canDelete="no" canReorder="no" />Comment   <ph id="c2" dataRef="d2" disp="{1:S}" equiv="" canCopy="no" canDelete="no" canReorder="no" />Share</source></segment></unit><unit id="u0098" name="^coursecontent0101" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">The collected clues will be stored in "Shared Folder"</source></segment></unit><unit id="u0099" name="^coursecontent0102" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">and classified.</source></segment></unit><unit id="u0100" name="^coursecontent0103" canResegment="no"><segment id="s1" state="initial"><source xml:space="preserve">Based on the logos behind the clues,</source></segment></unit></file></xliff>